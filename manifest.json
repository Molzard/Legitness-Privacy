{
    "manifest_version": 3,
    "name": "Legitness Privacy",
    "version": "1.1.0",
    "description": "Modular privacy & censor tool for web",
    "permissions": [
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "https://www.instagram.com/*",

        "https://gemini.google.com/*",

        "https://chatgpt.com/*",

        "https://claude.ai/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://www.instagram.com/*",

                "https://gemini.google.com/*",

                "https://chatgpt.com/*",

                "https://claude.ai/*"
            ],
            "js": [
                "config.js",
                "effects.js",
                "engine.js"
            ]
        }
    ],
    "action": {
        "default_popup": "popup.html"
    }

    
}